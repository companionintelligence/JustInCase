{
  "$schema": "https://raw.githubusercontent.com/companionintelligence/CI-Common/main/packages/video-kit/schema/storyboard.schema.json",
  "app": {
    "id": "ci-just-in-case",
    "name": "Just In Case",
    "repo": "companionintelligence/JustInCase",
    "marketplaceId": "ci-just-in-case",
    "website": "ci.computer"
  },
  "meta": {
    "fps": 30,
    "transitionSeconds": 0.5,
    "pacing": "fit"
  },
  "chapters": {
    "first-run": "First run",
    "ask": "Ask and verify",
    "offline": "When a piece is missing"
  },
  "media": {
    "music": null,
    "musicVolume": 0.14
  },
  "scenes": [
    {
      "id": "open",
      "kind": "intro",
      "seconds": 4.5,
      "title": "Just In Case",
      "caption": "Emergency knowledge, offline.",
      "narration": "Just In Case is an offline emergency knowledge assistant.",
      "mark": "./assets/app-icon.png",
      "reveal": "paced"
    },
    {
      "id": "first-launch",
      "kind": "screen",
      "chapter": "first-run",
      "seconds": 6,
      "caption": "First launch. Nothing indexed yet.",
      "narration": "On first launch the library is empty, and the panel says so plainly.",
      "shots": [
        {
          "id": "welcome-empty",
          "url": "just-in-case.local",
          "alt": "Just In Case on first launch: brand hero, suggested questions, and an empty field library",
          "motion": "push-in",
          "capture": {
            "path": "/?stage=empty",
            "waitFor": ".welcome h1",
            "waitUntil": "networkidle",
            "settle": 500,
            "before": [
              {
                "waitFor": "#status-pill.warn"
              },
              {
                "waitFor": ".library-empty"
              },
              {
                "waitFor": ".chips .chip"
              }
            ]
          }
        }
      ]
    },
    {
      "id": "field-library",
      "kind": "screen",
      "chapter": "first-run",
      "seconds": 6,
      "caption": "Copy documents in. Ingestion indexes them.",
      "narration": "Copy reference documents into the sources volume. Ingestion indexes them.",
      "shots": [
        {
          "id": "library-indexed",
          "url": "just-in-case.local",
          "alt": "The field library sidebar listing thirty-two indexed documents grouped by category",
          "motion": "drift-down",
          "capture": {
            "path": "/?stage=ready",
            "waitFor": "#status-pill.ok",
            "waitUntil": "networkidle",
            "settle": 500,
            "before": [
              {
                "waitFor": ".lib-file"
              },
              {
                "eval": "(() => { const t = document.getElementById('sidebar-toggle'); if (getComputedStyle(t).display !== 'none') { t.click(); } else { document.getElementById('sidebar').classList.add('open'); } })()"
              },
              {
                "wait": 150
              }
            ]
          }
        }
      ]
    },
    {
      "id": "library-shelf",
      "kind": "screen",
      "chapter": "first-run",
      "seconds": 6,
      "caption": "Scroll the shelf. Eight categories, thirty-two documents.",
      "narration": "The whole shelf stays browsable offline, on hardware you own.",
      "shots": [
        {
          "id": "library-scrolled",
          "url": "just-in-case.local",
          "alt": "The field library scrolled past its first categories, showing later category headers and their reference filenames with per-document chunk counts",
          "motion": "push-in",
          "capture": {
            "path": "/?stage=ready",
            "waitFor": "#status-pill.ok",
            "waitUntil": "networkidle",
            "settle": 500,
            "before": [
              {
                "waitFor": "#library-list .lib-cat"
              },
              {
                "eval": "(() => { const t = document.getElementById('sidebar-toggle'); if (getComputedStyle(t).display !== 'none') { t.click(); } else { document.getElementById('sidebar').classList.add('open'); } })()"
              },
              {
                "wait": 150
              },
              {
                "eval": "document.getElementById('library-list').scrollTop = 640"
              },
              {
                "wait": 150
              }
            ]
          }
        }
      ]
    },
    {
      "id": "type-a-question",
      "kind": "screen",
      "chapter": "ask",
      "seconds": 6,
      "caption": "Type your own. The question never leaves the machine.",
      "narration": "Type any question in plain language; nothing leaves the device to answer it.",
      "shots": [
        {
          "id": "question-typed",
          "url": "just-in-case.local",
          "alt": "A question of the viewer's own — how long to boil creek water — typed into the composer, with the six suggested-question chips still offered above it",
          "motion": "drift-down",
          "capture": {
            "path": "/?stage=ready",
            "waitFor": ".chips .chip",
            "waitUntil": "networkidle",
            "settle": 500,
            "before": [
              {
                "waitFor": ".chips .chip"
              },
              {
                "fill": [
                  "#user-input",
                  "How long do I boil creek water to make it safe?"
                ]
              },
              {
                "eval": "(() => { const i = document.getElementById('user-input'); i.setSelectionRange(0, 0); i.scrollLeft = 0; })()"
              }
            ]
          }
        }
      ]
    },
    {
      "id": "ask-a-question",
      "kind": "screen",
      "chapter": "ask",
      "seconds": 6.5,
      "caption": "Retrieval finds the passages. A local model writes the answer.",
      "narration": "Ask a question. Retrieval finds the passages, and a model on this device answers.",
      "shots": [
        {
          "id": "answer",
          "url": "just-in-case.local",
          "alt": "The typed question — how long to boil creek water — asked and answered in the chat, with a collapsed sources accordion",
          "motion": "push-in",
          "capture": {
            "path": "/?stage=ready",
            "waitFor": ".chips .chip",
            "waitUntil": "networkidle",
            "settle": 600,
            "before": [
              {
                "waitFor": ".chips .chip"
              },
              {
                "fill": [
                  "#user-input",
                  "How long do I boil creek water to make it safe?"
                ]
              },
              {
                "click": "#send-button"
              },
              {
                "waitFor": ".msg.bot .msg-bubble"
              },
              {
                "waitFor": "details.sources > summary"
              }
            ]
          }
        }
      ]
    },
    {
      "id": "check-the-sources",
      "kind": "screen",
      "chapter": "ask",
      "seconds": 6.5,
      "caption": "Every answer opens onto the documents behind it.",
      "narration": "See exactly which documents the answer came from. Verify before you act.",
      "shots": [
        {
          "id": "sources-open",
          "url": "just-in-case.local",
          "alt": "The expanded sources accordion listing the three documents the answer was drawn from, each with the passage that matched",
          "motion": "drift-down",
          "capture": {
            "path": "/?stage=ready",
            "waitFor": ".chips .chip",
            "waitUntil": "networkidle",
            "settle": 600,
            "before": [
              {
                "waitFor": ".chips .chip"
              },
              {
                "fill": [
                  "#user-input",
                  "How long do I boil creek water to make it safe?"
                ]
              },
              {
                "click": "#send-button"
              },
              {
                "waitFor": ".msg.bot .msg-bubble"
              },
              {
                "click": "details.sources > summary"
              },
              {
                "waitFor": ".source-item .source-snippet"
              },
              {
                "eval": "document.getElementById('chat').scrollTop = document.getElementById('chat').scrollHeight"
              },
              {
                "wait": 150
              }
            ]
          }
        }
      ]
    },
    {
      "id": "no-model-no-panic",
      "kind": "screen",
      "chapter": "offline",
      "seconds": 6,
      "caption": "No model on the box? It says so, and keeps going.",
      "narration": "With no language model installed it says so, and the library stays browsable.",
      "shots": [
        {
          "id": "degraded",
          "url": "just-in-case.local",
          "alt": "The degraded state: an LLM missing status pill and a banner naming the directory the model files belong in",
          "motion": "push-in",
          "capture": {
            "path": "/?stage=degraded",
            "waitFor": "#status-pill.err",
            "waitUntil": "networkidle",
            "settle": 500,
            "before": [
              {
                "waitFor": "#banner"
              },
              {
                "waitFor": ".lib-file"
              }
            ]
          }
        }
      ]
    },
    {
      "id": "recap",
      "kind": "feature",
      "seconds": 6,
      "title": "Runs on your hardware",
      "caption": "One Docker stack. No accounts, no cloud.",
      "narration": "One Docker stack. No accounts, no cloud. It keeps working when the network does not.",
      "items": [
        {
          "label": "Network",
          "value": "Not required"
        },
        {
          "label": "Monthly fee",
          "value": "$0"
        },
        {
          "label": "Retrieval",
          "value": "Hybrid search"
        },
        {
          "label": "Answers",
          "value": "Cited"
        }
      ],
      "reveal": "paced"
    },
    {
      "id": "close",
      "kind": "outro",
      "seconds": 4.5,
      "cta": "UnCloud your life.",
      "url": "ci.computer",
      "narration": "From Companion Intelligence. UnCloud your life.",
      "mark": "brand:logo.full"
    }
  ]
}
