{
  "permissions": {
    "allow": [
      "Bash(docker compose*)",
      "Bash(cmake*)",

      "Bash(git status)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git branch*)",
      "Bash(git fetch*)",
      "Bash(gh issue*)",
      "Bash(gh pr*)",
      "Bash(docker ps*)",
      "Bash(docker logs*)",

      "Bash(make -C tests/unit*)",
      "Bash(./helper-scripts/test-config.sh*)",
      "Bash(./helper-scripts/test-server.sh*)",
      "Bash(scripts/vendor-brand.sh*)"
    ],
    "deny": []
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.sh",
            "timeout": 600,
            "statusMessage": "Preparing JIC checks…"
          }
        ]
      }
    ]
  }
}
